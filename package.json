{
  "name": "node-mcp-server",
  "version": "0.1.0",
  "description": "Generic MCP server bootstrap template for creating new Model Context Protocol servers",
  "packageManager": "yarn@4.10.3",
  "type": "module",
  "main": "./dist/server.js",
  "bin": "./bin/cli.js",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest --run tests/tools tests/utils tests/scripts tests/server.test.ts",
    "test:integration": "vitest --run tests/integration",
    "test:bootstrap": "vitest --run tests/scripts tests/integration/bootstrap-e2e.test.ts",
    "test:inspector": "bash scripts/test-inspector.sh",
    "test:inspector:ui": "npx mcp-inspector --config inspector-config.json"
  },
  "keywords": [
    "mcp",
    "bootstrap",
    "model-context-protocol",
    "template",
    "server"
  ],
  "author": "suhcodes",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@modelcontextprotocol/inspector": "^0.17.1",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
